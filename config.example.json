{
  "defaultIndex": "my-app",
  "globalExclude": [
    "vendor",
    "node_modules",
    "_build",
    "deps",
    ".git",
    "storage",
    "dist",
    "build"
  ],
  "indexes": [
    {
      "name": "my-app",
      "root": "~/src/my-app",
      "adapter": "laravel",
      "include": [
        "app"
      ],
      "exclude": [],
      "options": {},
      "enabled": true
    },
    {
      "name": "legacy-app",
      "root": "~/src/legacy-app",
      "adapter": "auto",
      "enabled": false
    }
  ],
  "guard": {
    "enabled": true,
    "protectedBranches": [
      "develop",
      "main",
      "master"
    ],
    "allowMerge": false,
    "noTruncate": {
      "enabled": true,
      "consumers": [
        "head",
        "tail",
        "less",
        "more",
        "cut",
        "grep",
        "egrep",
        "rg",
        "sed",
        "awk",
        "Select-Object",
        "Select-String",
        "Format-Table",
        "findstr"
      ]
    },
    "noSuppress": {
      "enabled": true,
      "disableCategories": []
    },
    "commitMessage": {
      "enabled": true,
      "commands": [
        {
          "name": "git",
          "listCommand": [
            "git",
            "--list-cmds=main,alias"
          ]
        }
      ]
    }
  },
  "houseRules": {
    "enabled": true,
    "mode": "extend",
    "files": [],
    "disable": []
  },
  "notesDir": "~/.config/stackmap/notes"
}
