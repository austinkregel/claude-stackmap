{
  "name": "stackmap",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Code plugin: deterministic code lookups, a durable cross-session note store, an action guard, and reusable data CLIs.",
  "type": "module",
  "bin": {
    "stackmap-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "guard-test": "node scripts/guard-test.mjs",
    "test": "npm run plugin-test && npm run shell-tokens-test && npm run guard-test && npm run truncate-test && npm run suppress-test && npm run house-rules-test && npm run hooks-test && npm run skill-check-test && npm run audit-test && npm run cli-test && npm run config-test && npm run extract-test && npm run notes-test && npm run smoke",
    "plugin-test": "node scripts/plugin-test.mjs",
    "cli-test": "node scripts/cli-test.mjs",
    "config-test": "node scripts/config-test.mjs",
    "shell-tokens-test": "node scripts/shell-tokens-test.mjs",
    "truncate-test": "node scripts/truncate-test.mjs",
    "suppress-test": "node scripts/suppress-test.mjs",
    "house-rules-test": "node scripts/house-rules-test.mjs",
    "hooks-test": "node scripts/hooks-test.mjs",
    "notes-test": "node scripts/notes-test.mjs",
    "skill-check-test": "node scripts/skill-check-test.mjs",
    "audit-test": "node scripts/audit-test.mjs",
    "bench": "node scripts/notes-bench.mjs",
    "extract-test": "node scripts/extract-test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.17"
  }
}
