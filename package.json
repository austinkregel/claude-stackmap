{
  "name": "stackmap",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Code plugin: deterministic code lookups, a durable cross-session note store, an action guard, and reusable data CLIs.",
  "type": "module",
  "bin": {
    "stackmap-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "guard-test": "node scripts/guard-test.mjs",
    "test": "npm run guard-test && npm run extract-test && npm run notes-test && npm run review-test && npm run smoke",
    "notes-test": "node scripts/notes-test.mjs",
    "review-test": "node scripts/review-test.mjs",
    "bench": "node scripts/notes-bench.mjs",
    "extract-test": "node scripts/extract-test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.17"
  }
}
